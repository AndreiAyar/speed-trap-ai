# Node modules should never be committed.
node_modules/

# Build outputs and temporary caches should stay local.
dist/
build/
.vite/
coverage/
*.tsbuildinfo
dist-radar/

# Documentation source footage/contact sheets stay private and local.
.local-media/

# Internal release checklist stays local.
/docs/github-preparation.md

# Model weights are downloaded by Ultralytics on the first run.
*.pt
*.onnx

# Local environment values must not be published.
.env
.env.*
!.env.example

# Python virtual environments and cache files should stay local.
.venv/
__pycache__/
*.pyc

# Local database and generated data are runtime artifacts.
data/output/*
!data/output/.gitkeep
data/input/*
!data/input/.gitkeep
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm

# Editor and OS noise files are not useful in git history.
.DS_Store
.vscode/
.idea/

# Runtime logs should be ignored.
*.log
